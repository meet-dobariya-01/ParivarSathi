    FE["React 18 + Vite\nReact Router + Tailwind\nreact-i18next (EN / GU / HI)\nRecharts + axios"]
  end

  subgraph API["API Layer"]
    GW["Express REST API\nJWT Auth\nValidation\nRate Limiting\nError Handling"]
  end

